{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/education.html",
      "destination": "/workbench.html",
      "permanent": false
    },
    {
      "source": "/education",
      "destination": "/workbench.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/resume",
      "destination": "/api/resume"
    },
    {
      "source": "/dashboard",
      "destination": "/api/dashboard"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/career",
      "destination": "/app.html"
    },
    {
      "source": "/dashboard/career",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
